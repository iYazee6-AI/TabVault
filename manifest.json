{
  "manifest_version": 3,
  "name": "TabVault: Open-Source Tab Manager",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/iYazee6-AI/TabVault",
  "description": "Every window and tab in one page or the side panel. Search, group, dedupe, unload idle tabs, reopen closed tabs, keep snapshots.",
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "sidePanel", "contextMenus", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open TabVault" },
  "side_panel": { "default_path": "app/index.html?panel=1" },
  "commands": {
    "open-tabvault": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open TabVault"
    },
    "open-side-panel": {
      "description": "Open TabVault in the side panel"
    },
    "focus-window": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Focus this window: veil every other window (again to lift)"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
